<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp"
    >

    <TextView
        android:id="@+id/tv_bs_salon_name"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="20sp"
        android:textStyle="bold"
        android:textColor="@color/gold_dark"
        android:layout_marginBottom="4dp"
        />
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/tv_bs_service_summary"
        android:textSize="15sp"
        android:textColor="@color/text_medium"
        android:layout_marginBottom="16dp"
        />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/layout_stylist_section"
        android:orientation="vertical"
        android:layout_marginBottom="16dp"
        >
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/choose_stylist"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"
            android:textColor="@color/text_dark"
            />

        <Spinner
            android:id="@+id/spinner_stylists"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            />

    </LinearLayout>

    <com.google.android.material.button.MaterialButton
        style="@style/Widget.Lustre.Button.Gold"
        android:paddingVertical="16dp"
        android:id="@+id/btn_pick_datetime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/pick_date_time"
        android:layout_marginBottom="8dp"/>

    <TextView
        android:id="@+id/tv_selected_time"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone"
        android:textColor="@color/gold_dark"
        android:layout_marginBottom="16dp"/>

    <ProgressBar
        android:id="@+id/progress_booking"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:visibility="gone"
        android:layout_marginBottom="8dp"/>

    <com.google.android.material.button.MaterialButton
        style="@style/Widget.Lustre.Button.Gold"
        android:paddingVertical="16dp"
        android:id="@+id/btn_confirm_booking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/confirm_booking"
        android:layout_marginBottom="16dp"/>

</LinearLayout>
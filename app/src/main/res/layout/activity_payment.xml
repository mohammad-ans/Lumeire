<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/cream_bg"
    android:fillViewport="true"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:paddingBottom="24dp"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingHorizontal="20dp"
            android:paddingTop="48dp"
            android:paddingBottom="8dp"
            android:background="@drawable/bg_gradient_gold_header"
            android:gravity="center_vertical"
            >
            <ImageButton
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:id="@+id/btn_back"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:contentDescription="@string/back"
                android:src="@android:drawable/ic_menu_revert"
                app:tint="@color/white"
                />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:fontFamily="serif"
                android:textStyle="bold"
                android:textColor="@color/white"
                android:textSize="20sp"
                android:text="Submit Payment"
                />
        </LinearLayout>
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp"
            >
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="20dp"
                android:orientation="vertical"
                android:background="@drawable/bg_loyalty_card"
                >
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Amount Due"
                    android:textColor="@color/cream_bg"
                    android:textSize="12sp"
                    />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:textSize="30sp"
                    android:layout_marginTop="6dp"
                    android:id="@+id/tv_amount_due"
                    android:textColor="@color/white"
                    android:textStyle="bold"
                    tools:text="USD 20"
                    />
            </LinearLayout>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Pay Using"
                android:textColor="@color/text_muted"
                android:textStyle="bold"
                />
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="@drawable/bg_card_white"
                android:layout_marginTop="10dp"
                android:id="@+id/layout_payment_details"
                >
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Hackclub Bank"
                    android:textColor="@color/text_dark"
                    android:id="@+id/tv_payment_method_name"
                    />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:id="@+id/tv_payment_acc"
                        android:textColor="@color/text_dark"
                        android:textSize="18sp"
                        tools:text="4024701274820"
                        />
                    <Button
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/btn_copy_number"
                        android:text="Copy"
                        android:textAllCaps="false"
                        android:textColor="@color/gold_dark"
                        style="?android:attr/borderlessButtonStyle"
                        />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="Send the amount above, and upload the screenshot below"
                    android:textColor="@color/text_muted"
                    android:textSize="12sp"
                    />
            </LinearLayout>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="Payment Screenshot"
                android:textColor="@color/text_muted"
                android:textStyle="bold"
                />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:background="@drawable/bg_card_white"
                android:orientation="vertical"
                android:padding="16dp"
                >
                <ImageView
                    android:layout_width="match_parent"
                    android:layout_height="200dp"
                    android:background="@color/cream_bg"
                    android:id="@+id/iv_proof_preview"
                    android:scaleType="centerCrop"
                    tools:visibility="visible"
                    android:visibility="gone"
                    android:contentDescription="Selected Payment Image"
                    />
                <Button
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:id="@+id/btn_pick_screenshot"
                    android:layout_marginTop="12dp"
                    android:text="Choose Image"
                    android:textAllCaps="false"
                    />
            </LinearLayout>
            <Button
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:id="@+id/btn_submit_img"
                android:layout_marginTop="24dp"
                android:background="@drawable/bg_gradient_gold_header"
                android:enabled="false"
                android:text="Submit Payment"
                android:textAllCaps="false"
                android:textColor="@color/white"
                android:textStyle="bold"
                />
            <ProgressBar
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:id="@+id/progress_submit"
                android:layout_gravity="center"
                android:layout_marginTop="16dp"
                android:visibility="gone"
                />
        </LinearLayout>
    </LinearLayout>
</androidx.core.widget.NestedScrollView>
<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/cream_bg"
    android:fillViewport="true"
    xmlns:tools="http://schemas.android.com/tools"
    >
   <LinearLayout
       android:layout_width="match_parent"
       android:layout_height="wrap_content"
       android:orientation="vertical"
       android:paddingBottom="24dp"
       >
       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="horizontal"
           android:paddingTop="48dp"
           android:paddingBottom="20dp"
           android:paddingEnd="20dp"
           android:paddingStart="8dp"
           android:background="@drawable/bg_gradient_gold_header"
           android:gravity="center_vertical"
           >
           <ImageButton
               android:layout_width="44dp"
               android:layout_height="44dp"
               android:id="@+id/btn_back"
               android:background="?attr/selectableItemBackgroundBorderless"
               android:contentDescription="@string/back"
               android:src="@android:drawable/ic_menu_revert"
               app:tint="@color/white"
               />
           <TextView
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginStart="8dp"
               android:fontFamily="serif"
               android:textStyle="bold"
               android:textColor="@color/white"
               android:textSize="20sp"
               android:text="@string/rewards_points"
               />
       </LinearLayout>
       <LinearLayout
           android:layout_width="match_parent"
           android:layout_height="wrap_content"
           android:orientation="vertical"
           android:padding="20dp">
           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:background="@drawable/bg_loyalty_card"
               android:orientation="vertical"
               android:padding="20dp"
               >
               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:id="@+id/tv_current_tier"
                   android:background="#2EFFFFFF"
                   android:paddingHorizontal="12dp"
                   android:paddingVertical="6dp"
                   android:textColor="@color/white"
                   android:textStyle="bold"
                   tools:text="Gold Member"
                   />
               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:id="@+id/tv_points_value"
                   android:layout_marginTop="14dp"
                   android:textColor="@color/white"
                   android:textSize="36sp"
                   android:textStyle="bold"
                   tools:text="1240"
                   />
               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:text="@string/points_label"
                   android:textColor="#CCFFFFFF"
                   android:textSize="12sp"
                   />
               <ProgressBar
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:id="@+id/pb_tier_progress"
                   android:layout_marginTop="16dp"
                   android:max="100"
                   android:progressTint="@color/white"
                   style="@android:style/Widget.ProgressBar.Horizontal"
                   />
               <TextView
                   android:layout_width="wrap_content"
                   android:layout_height="wrap_content"
                   android:id="@+id/tv_next_tier_info"
                   android:layout_marginTop="8dp"
                   android:textColor="#CCFFFFFF"
                   android:textSize="12sp"
                   tools:text="260 more points to reach Platinum"
                   />
           </LinearLayout>
           <TextView
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginTop="24dp"
               android:text="@string/membership_tiers"
               android:textColor="@color/text_muted"
               android:textStyle="bold"
               />
           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:id="@+id/tier_list_container"
               android:background="@drawable/bg_card_white"
               android:orientation="vertical"
               android:layout_marginTop="10dp"
               />
           <TextView
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_marginTop="24dp"
               android:text="@string/how_to_earn_points"
               android:textColor="@color/text_muted"
               android:textStyle="bold"
               />
           <LinearLayout
               android:layout_width="match_parent"
               android:layout_height="wrap_content"
               android:layout_marginTop="10dp"
               android:background="@drawable/bg_card_white"
               android:orientation="vertical"
               android:padding="16dp"
               >
               <TextView
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:text="@string/earn_points_rule_booking"
                   android:textColor="@color/text_dark"
                   />
               <TextView
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:text="@string/earn_points_rule_referral"
                   android:layout_marginTop="10dp"
                   android:textColor="@color/text_dark"
                   />
               <TextView
                   android:layout_width="match_parent"
                   android:layout_height="wrap_content"
                   android:layout_marginTop="10dp"
                   android:text="@string/earn_points_rule_review"
                   android:textColor="@color/text_dark"
                   />
           </LinearLayout>
       </LinearLayout>
   </LinearLayout>
</androidx.core.widget.NestedScrollView>
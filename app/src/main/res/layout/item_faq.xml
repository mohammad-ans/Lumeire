<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:tools="http://schemas.android.com/tools"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/row_faq_question"
        android:gravity="center_vertical"
        android:padding="16dp"
        >
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:id="@+id/tv_faq_question"
            android:layout_weight="1"
            android:textColor="@color/text_dark"
            android:textStyle="bold"
            tools:text="How do I cancel a booking?"
            />
        <ImageView
            android:id="@+id/tv_faq_chevron"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@android:drawable/arrow_down_float"
            />
    </LinearLayout>
    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/tv_faq_answer"
        android:paddingHorizontal="16dp"
        android:paddingBottom="16dp"
        android:textSize="13sp"
        android:textColor="@color/text_muted"
        android:visibility="gone"
        tools:visibility="gone"
        tools:text="Open the booking from My Bookings and tap Cancel up to 2 hours before your appointment."
        />
    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:background="@color/cream_bg"
        />
</LinearLayout>